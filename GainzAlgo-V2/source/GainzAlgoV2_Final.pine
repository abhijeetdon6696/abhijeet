// @version=6
// GainzAlgo-V2: Simplified Strategy - Buy/Sell Signals Only
// Clean Pine Script v6 - Focused on Entry Signals

indicator(title="GainzAlgo-V2", shorttitle="GainzAlgo", overlay=true, max_labels_count=500)

// ==================== INDICATOR CALCULATIONS ====================
// EMA
ema_fast = ta.ema(close, 9)
ema_slow = ta.ema(close, 21)
ema_extra_slow = ta.ema(close, 50)

// RSI
rsi = ta.rsi(close, 14)

// MACD
[macd_line, signal_line, histogram] = ta.macd(close, 12, 26, 9)

// ATR
atr_val = ta.atr(14)

// ==================== TREND ANALYSIS ====================
ema_aligned_up = ema_fast > ema_slow and ema_slow > ema_extra_slow
ema_aligned_down = ema_fast < ema_slow and ema_slow < ema_extra_slow
trend_direction = ema_aligned_up ? 1 : (ema_aligned_down ? -1 : 0)

// ==================== MOMENTUM ANALYSIS ====================
macd_positive = macd_line > signal_line
rsi_overbought = rsi > 70
rsi_oversold = rsi < 30

// ==================== SMART MONEY DETECTION ====================
higher_high = high == ta.highest(high, 10)
lower_low = low == ta.lowest(low, 10)

// BOS Detection
bos_up = close > ta.highest(high, 20)
bos_down = close < ta.lowest(low, 20)

// ==================== ENTRY CONDITIONS ====================
buy_condition = trend_direction == 1 and ema_aligned_up and (bos_up or higher_high) and macd_positive and not rsi_overbought

sell_condition = trend_direction == -1 and ema_aligned_down and (bos_down or lower_low) and not macd_positive and not rsi_oversold

// ==================== SIGNALS ONLY ====================
if buy_condition
    label.new(bar_index, low - atr_val * 0.5, "🟢 BUY", color=color.new(#089981, 0), textcolor=color.white, style=label.style_label_up, size=size.large)
    
if sell_condition
    label.new(bar_index, high + atr_val * 0.5, "🔴 SELL", color=color.new(#F23645, 0), textcolor=color.white, style=label.style_label_down, size=size.large)
