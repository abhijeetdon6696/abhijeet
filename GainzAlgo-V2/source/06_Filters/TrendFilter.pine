// @version=6
// GainzAlgo-V2: Trend Filter
// Multi-timeframe trend confirmation

// ==================== TREND CONFIRMATION ====================
f_trend_filter(ema_fast, ema_slow, extra_slow) =>
    trending_up = ema_fast > ema_slow and ema_slow > extra_slow
    trending_down = ema_fast < ema_slow and ema_slow < extra_slow
    
    if trending_up
        1  // Uptrend
    else if trending_down
        -1  // Downtrend
    else
        0  // Sideways

// ==================== TREND STRENGTH ====================
f_trend_strength(fast_ema, slow_ema, atr_val) =>
    distance = math.abs(fast_ema - slow_ema)
    atr_pips = atr_val / syminfo.mintick
    strength = distance / atr_pips
    math.min(strength, 5.0)  // Cap at 5x

// ==================== TREND SLOPE ====================
f_trend_acceleration(ema_current, ema_prev, slope_prev) =>
    current_slope = (ema_current - ema_prev) / ema_prev * 100
    if math.abs(current_slope) > math.abs(slope_prev)
        "ACCELERATING"
    else if math.abs(current_slope) < math.abs(slope_prev)
        "DECELERATING"
    else
        "STEADY"

// ==================== ONLY TRADE WITH TREND ====================
f_trade_with_trend(direction, trend_direction) =>
    if direction == 1  // Want to go long
        trend_direction == 1
    else if direction == -1  // Want to go short
        trend_direction == -1
    else
        false

// ==================== TREND FILTER SCORE ====================
f_trend_filter_score(trend_strength, ema_alignment, price_position) =>
    score = 0.0
    score += trend_strength * 5  // 0-25
    if ema_alignment
        score += 20.0
    score += price_position * 10  // 0-10
    math.min(score, 100.0)
