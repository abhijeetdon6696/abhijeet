// @version=6
// GainzAlgo-V2: CHOCH (Change of Character)
// Smart money trend reversal detection

type CHOCHData
    type : int
    level : float
    bar_index : int
    confirmed : bool
    strength : float

// ==================== CHOCH DETECTION ====================
f_detect_choch_bullish(structure_type, prev_structure_type) =>
    // Transition from LL/LH to HH/HL
    prev_bearish = prev_structure_type == "LL" or prev_structure_type == "LH"
    curr_bullish = structure_type == "HH" or structure_type == "HL"
    prev_bearish and curr_bullish

f_detect_choch_bearish(structure_type, prev_structure_type) =>
    // Transition from HH/HL to LL/LH
    prev_bullish = prev_structure_type == "HH" or prev_structure_type == "HL"
    curr_bearish = structure_type == "LL" or structure_type == "LH"
    prev_bullish and curr_bearish

// ==================== CHOCH CONFIRMATION ====================
f_choch_confirmed(choch_level, close, candles_confirmation) =>
    confirmations = 0
    for i = 0 to candles_confirmation - 1
        if close[i] > choch_level
            confirmations += 1
    confirmations >= math.ceil(candles_confirmation / 2)

// ==================== CHOCH STRENGTH ====================
f_choch_strength(choch_level, current_price, atr_val) =>
    distance = math.abs(current_price - choch_level)
    strength = distance / atr_val
    math.min(strength, 5.0)

// ==================== CHOCH TYPES ====================
f_choch_type_text(choch_direction) =>
    if choch_direction == 1
        "🟢 BULLISH CHOCH"
    else if choch_direction == -1
        "🔴 BEARISH CHOCH"
    else
        "⚪ NO CHOCH"
